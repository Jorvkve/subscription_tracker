# Supabase Dashboard > Connect > Transaction pooler (port 6543).
# Prisma uses pgbouncer=true for Supavisor transaction mode.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true&sslmode=verify-full&sslrootcert=certs/supabase-ca.crt"
# Supabase Dashboard > Connect > Direct connection (port 5432), or Session pooler
# (port 5432) when the network cannot reach Supabase's IPv6 direct endpoint.
# Used only by Prisma CLI commands such as migrate dev/deploy.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt"
# Base64 of certs/supabase-ca.crt, for the serverless runtime (e.g. Vercel).
SUPABASE_DB_CA_BASE64=""
AUTH_SECRET="generate-a-long-random-secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
ALLOWED_GOOGLE_EMAILS="you@example.com"
CRON_SECRET="generate-a-separate-long-random-secret"
APP_TIMEZONE="Asia/Bangkok"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_APP_PASSWORD=""
REMINDER_EMAIL_TO=""
