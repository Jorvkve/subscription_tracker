// Cloudflare Workers deployment, built with OpenNext. Vercel ignores this file.
// Secrets (DATABASE_URL, AUTH_SECRET, ...) live in the Worker's settings, not here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subscription-tracker",
  // Wraps .open-next/worker.js and adds the scheduled (cron) handler.
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference binding used by OpenNext; must match the worker name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "subscription-tracker"
    }
  ],
  "hyperdrive": [
    {
      // Supabase through Hyperdrive (session pooler, verify-full against Supabase's root CA,
      // caching disabled so pages never show stale rows). Used by src/lib/prisma.ts.
      "binding": "HYPERDRIVE",
      "id": "74e1b00a47e74b62b3f85580e6c9288b",
      // Only for local emulation: `opennextjs-cloudflare deploy` reads bindings through
      // Wrangler's platform proxy, which refuses a Hyperdrive binding without one. Production
      // ignores it and uses the Hyperdrive config above.
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Replaced Vercel's crons on 2026-11-17; each maps to a route in cloudflare-worker.mjs.
  "triggers": {
    "crons": ["0 18 * * *", "0 14 * * *"]
  },
  // Keep plain-text variables set in the dashboard (GEMINI_API_KEY) across deploys.
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
